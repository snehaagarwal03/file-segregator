# Copy this file to .env and fill in your values.
# .env is gitignored — your API key will never be committed.

# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override which folder the agent watches (default: ~/Downloads)
# WATCH_FOLDER=/custom/path/to/watch

# Optional: override where sorted files are placed (default: ~/Downloads/sorted)
# SORTED_ROOT=/custom/path/for/sorted
